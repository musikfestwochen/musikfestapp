{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "test": "vitest run",
        "test:architecture": "vitest run resources/js/architecture.test.ts",
        "test:watch": "vitest watch",
        "test:coverage": "vitest run --coverage",
        "typecheck": "vue-tsc --noEmit",
        "mailpit:start": "mailpit",
        "mailpit:check": "curl -f http://localhost:8025/api/v1/info || echo 'Mailpit is not running'",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui",
        "e2e:headed": "playwright test --headed",
        "e2e:codegen": "playwright codegen musikfestapp.test",
        "e2e:codegen:mobile": "playwright codegen --device=\"iPhone 14\" musikfestapp.test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "10.6.0",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.4",
        "@testing-library/vue": "^8.1.0",
        "@types/node": "26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "@vitest/ui": "^5.1.0",
        "@vue/eslint-config-typescript": "14.9.0",
        "@vue/test-utils": "2.5.1",
        "dotenv": "18.0.9",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-formatter-compact": "^9.0.1",
        "eslint-plugin-vue": "^10.12.0",
        "happy-dom": "21.0.4",
        "prettier": "^3.9.10",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "sharp": "^0.35.5",
        "svgo": "^4.1.0",
        "typescript-eslint": "^8.72.1",
        "vite-plugin-image-optimizer": "^2.0.3",
        "vitest": "^5.1.0",
        "vue-tsc": "3.3.13"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.23",
        "@inertiajs/vue3": "^3.11.0",
        "@lucide/vue": "^1.67.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tanstack/vue-table": "^9.3.1",
        "@unovis/ts": "^1.7.1",
        "@unovis/vue": "^1.7.1",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vueuse/core": "^15.0.0",
        "autoprefixer": "^10.6.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.6",
        "laravel-vite-plugin": "^3.2.0",
        "lucide": "1.67.0",
        "lucide-vue-next": "1.0.0",
        "radix-vue": "^1.9.17",
        "reka-ui": "^2.11.0",
        "tailwind-merge": "3.7.0",
        "tailwindcss": "^4.3.4",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vue": "^3.5.44",
        "ziggy-js": "^2.6.5"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.67.4",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.4",
        "lightningcss-linux-x64-gnu": "^1.33.0"
    },
    "overrides": {
        "js-beautify": "2.0.3",
        "shell-quote": "1.12.0"
    }
}
