{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "test:coverage": "vitest run --coverage",
        "mailpit:start": "mailpit",
        "mailpit:check": "curl -f http://localhost:8025/api/v1/info || echo 'Mailpit is not running'",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui",
        "e2e:headed": "playwright test --headed",
        "e2e:codegen": "playwright codegen musikfestapp.test",
        "e2e:codegen:mobile": "playwright codegen --device=\"iPhone 14\" musikfestapp.test",
        "simulate-sensors": "node scripts/simulate-sensors.js",
        "simulate-sensors:help": "node scripts/simulate-sensors.js --help"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@faker-js/faker": "^9.8.0",
        "@playwright/test": "^1.53.0",
        "@testing-library/vue": "^8.1.0",
        "@types/node": "^22.13.5",
        "@vite-pwa/assets-generator": "^1.0.0",
        "@vitest/coverage-v8": "^3.2.3",
        "@vitest/ui": "^3.2.3",
        "@vue/eslint-config-typescript": "^14.3.0",
        "@vue/test-utils": "^2.4.6",
        "dotenv": "^16.5.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-vue": "^9.32.0",
        "happy-dom": "^18.0.1",
        "prettier": "^3.4.2",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.6.9",
        "sharp": "^0.34.2",
        "typescript-eslint": "^8.23.0",
        "vite-plugin-imagemin": "^0.6.1",
        "vitest": "^3.2.3",
        "vue-tsc": "^2.2.4"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.23",
        "@inertiajs/vue3": "^2.0.0-beta.3",
        "@tailwindcss/forms": "^0.5.3",
        "@tanstack/vue-table": "^8.21.3",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vuepic/vue-datepicker": "^11.0.2",
        "@vueuse/core": "^12.8.2",
        "autoprefixer": "^10.4.20",
        "axios": "^1.11.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "knex": "^3.1.0",
        "laravel-vite-plugin": "^1.0",
        "lucide": "^0.468.0",
        "lucide-vue-next": "^0.468.0",
        "radix-vue": "^1.9.11",
        "reka-ui": "^2.4.0",
        "rrule": "^2.8.1",
        "sqlite3": "^5.1.7",
        "tailwind-merge": "^2.6.0",
        "tailwindcss": "^3.4.1",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5.2.2",
        "vite": "^6.3.5",
        "vue": "^3.5.13",
        "ziggy-js": "^2.4.2"
