{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "test": "vitest run",
        "test:architecture": "vitest run resources/js/architecture.test.ts",
        "test:watch": "vitest watch",
        "test:coverage": "vitest run --coverage",
        "typecheck": "vue-tsc --noEmit",
        "mailpit:start": "mailpit",
        "mailpit:check": "curl -f http://localhost:8025/api/v1/info || echo 'Mailpit is not running'",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui",
        "e2e:headed": "playwright test --headed",
        "e2e:codegen": "playwright codegen musikfestapp.test",
        "e2e:codegen:mobile": "playwright codegen --device=\"iPhone 14\" musikfestapp.test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "10.5.0",
        "@playwright/test": "^1.62.0",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/vue": "^8.1.0",
        "@types/node": "26.1.2",
        "@vitest/coverage-v8": "^4.1.10",
        "@vitest/ui": "^4.1.5",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "2.4.11",
        "dotenv": "17.4.2",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-formatter-compact": "^9.0.1",
        "eslint-plugin-vue": "^10.10.0",
        "happy-dom": "20.11.1",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "sharp": "^0.35.3",
        "svgo": "^4.0.2",
        "typescript-eslint": "^8.66.0",
        "vite-plugin-image-optimizer": "^2.0.3",
        "vitest": "^4.1.5",
        "vue-tsc": "3.3.9"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.23",
        "@inertiajs/vue3": "^3.6.1",
        "@lucide/vue": "^1.30.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tanstack/vue-table": "^9.0.0",
        "@unovis/ts": "^1.6.7",
        "@unovis/vue": "^1.6.7",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vueuse/core": "^14.3.0",
        "autoprefixer": "^10.5.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.4",
        "laravel-vite-plugin": "^3.1.3",
        "lucide": "1.30.0",
        "lucide-vue-next": "1.0.0",
        "radix-vue": "^1.9.11",
        "reka-ui": "^2.10.1",
        "tailwind-merge": "3.6.0",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^6.0.3",
        "vite": "^8.2.1",
        "vue": "^3.5.41",
        "ziggy-js": "^2.6.3"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.62.4",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.33.0"
    },
    "overrides": {
        "js-beautify": "2.0.3",
        "shell-quote": "1.10.0"
    }
}
