{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "test:coverage": "vitest run --coverage",
        "mailpit:start": "mailpit",
        "mailpit:check": "curl -f http://localhost:8025/api/v1/info || echo 'Mailpit is not running'",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui",
        "e2e:headed": "playwright test --headed",
        "e2e:codegen": "playwright codegen musikfestapp.test",
        "e2e:codegen:mobile": "playwright codegen --device=\"iPhone 14\" musikfestapp.test",
        "simulate-sensors": "node scripts/simulate-sensors.js",
        "simulate-sensors:help": "node scripts/simulate-sensors.js --help"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "10.5.0",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/vite": "^4.3.1",
        "@testing-library/vue": "^8.1.0",
        "@types/node": "26.0.1",
        "@vite-pwa/assets-generator": "^1.0.0",
        "@vitest/coverage-v8": "^4.1.9",
        "@vitest/ui": "^4.1.5",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "2.4.11",
        "dotenv": "17.4.2",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-formatter-compact": "^9.0.1",
        "eslint-plugin-vue": "^10.9.2",
        "happy-dom": "20.10.6",
        "prettier": "^3.9.1",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "sharp": "^0.35.2",
        "svgo": "^4.0.1",
        "typescript-eslint": "^8.62.0",
        "vite-plugin-image-optimizer": "^2.0.3",
        "vitest": "^4.1.5",
        "vue-tsc": "3.3.5"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.23",
        "@inertiajs/vue3": "^3.5.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tanstack/vue-table": "^8.21.3",
        "@unovis/ts": "^1.6.7",
        "@unovis/vue": "^1.6.7",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vuepic/vue-datepicker": "14.0.0",
        "@vueuse/core": "14.3.0",
        "autoprefixer": "^10.5.2",
        "axios": "^1.18.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.3",
        "knex": "^3.3.0",
        "laravel-vite-plugin": "^3.1.0",
        "lucide": "1.22.0",
        "lucide-vue-next": "1.0.0",
        "radix-vue": "^1.9.11",
        "reka-ui": "^2.10.1",
        "sqlite3": "6.0.1",
        "tailwind-merge": "3.6.0",
        "tailwindcss": "^4.3.1",
