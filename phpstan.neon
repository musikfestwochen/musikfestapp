includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - app/

    # Level 10 is the highest level
    level: 7

services:
    -
        class: App\PHPStan\Rules\ForbiddenMethodsRule
        tags:
            - phpstan.rules.rule

#    ignoreErrors:
#        - '#PHPDoc tag @var#'
