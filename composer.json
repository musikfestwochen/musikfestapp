{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/vue-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "fakerphp/faker": "^1.23",
        "guzzlehttp/guzzle": "^7.9",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.0",
        "laravel/pulse": "^1.4",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "laravel/vonage-notification-channel": "^3.3",
        "markrogoyski/math-php": "^2.11",
        "spatie/laravel-permission": "^7.4",
        "tightenco/ziggy": "^2.4"
    },
    "require-dev": {
        "bambamboole/laravel-mermaid-erd": "^0.3.5",
        "barryvdh/laravel-debugbar": "^4.2",
        "driftingly/rector-laravel": "^2.0",
        "jasonmccreary/laravel-test-assertions": "^2.8",
        "larastan/larastan": "^3.1",
        "laravel/boost": "^2.1",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "peckphp/peck": "0.3",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-drift": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "App\\PHPStan\\": "app/PHPStan/"
        }
    },
    "scripts": {
        "mailpit": [
            "mailpit"
        ],
        "dev": [
            "echo \"Use Herd!\""
        ],
        "typos": [
            "peck"
        ],
        "lint": [
            "pint",
            "npm run lint",
            "npm run format"
        ],
        "lint:ai": [
            "pint --quiet",
            "npx eslint . --fix --quiet --format compact",
            "npx prettier --write resources/ --log-level error"
        ],
        "rector": [
            "rector"
        ],
        "test:sca": [
            "phpstan --xdebug"
        ],
        "test:sca:ai": [
            "phpstan --xdebug --no-progress --error-format=raw"
        ],
        "test:coverage": [
            "pest --coverage --parallel --min=100"
        ],
        "test:coverage:ai": [
            "pest --coverage --parallel --min=100 --compact --no-progress --coverage-text=storage/logs/precommit-ai-coverage.txt --only-summary-for-coverage-text"
        ],
        "test:types": [
            "pest --type-coverage --parallel --min=100"
        ],
        "test:types:ai": [
            "pest --type-coverage --parallel --min=100 --compact --no-progress"
        ],
        "test:mutation": [
            "Composer\\Config::disableProcessTimeout",
            "pest --mutate --parallel --covered-only --min=100 --ignore-min-score-on-zero-mutations"
        ],
        "test:mutation:ai": [
            "Composer\\Config::disableProcessTimeout",
            "pest --mutate --parallel --covered-only --min=100 --ignore-min-score-on-zero-mutations --compact --no-progress"
        ],
        "test:e2e": [
            "npm run build",
            "npm run e2e",
            "php artisan migrate:fresh --seed"
        ],
        "test:e2e:ai": [
            "npx vite build --logLevel error",
            "npx playwright test --reporter=line --quiet",
            "php artisan migrate:fresh --seed --quiet"
        ],
        "test": [
            "npm run test",
            "@test:sca",
            "@test:coverage",
            "@test:types",
            "@test:mutation",
            "@test:e2e"
        ],
        "test:ai": [
            "npx vitest run --reporter=dot --silent=passed-only",
            "@test:sca:ai",
            "@test:coverage:ai",
            "@test:types:ai",
            "@test:mutation:ai",
            "@test:e2e:ai"
        ],
        "docs:erd": [
            "php artisan generate:mermaid-erd --output=file --path=docs/diagrams/erd.md"
        ],
        "precommit": [
            "@rector",
            "@typos",
            "@lint",
            "@test"
        ],
        "precommit:ai": [
            "@rector",
            "@typos",
            "@lint:ai",
            "@test:ai"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi",
            "@php -r \"if (file_exists('AGENTS.md')) { is_dir('.github') || mkdir('.github', 0777, true); copy('AGENTS.md', '.github/copilot-instructions.md'); }\"",
            "@docs:erd"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
